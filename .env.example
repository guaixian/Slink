# 复制为 .env 后由 docker compose 加载
# openssl rand -base64 48
SLINK_JWT_SECRET=replace_with_long_random_string

# 可选：数据落在宿主机上的根目录（默认 /mnt/usb1/Slink，其下会挂载 config、data、static）
# SLINK_DATA_ROOT=/mnt/usb1/Slink

# 可选：AI 图片处理外置扩展（智能去水印 / 超分辨率 / 智能打标）
# 不设置则相关接口 /api/image/ai/* 返回 501；对接说明见 docs/ai-extension.md
# SLINK_AI_ENDPOINT=http://127.0.0.1:9000
# SLINK_AI_TOKEN=
# SLINK_AI_TIMEOUT=120
