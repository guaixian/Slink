# 复制为 .env 后由 docker compose 加载
# openssl rand -base64 48
SLINK_JWT_SECRET=replace_with_long_random_string

# 可选：数据落在宿主机上的根目录（默认 /mnt/usb1/Slink，其下会挂载 config、data、static）
# SLINK_DATA_ROOT=/mnt/usb1/Slink

# 可选：AI 设置也可在后台「AI 设置」页面中填写（入库），下列环境变量优先级更高，
# 设置后对应字段在后台变为只读（适合 Docker/K8s 注入密钥，避免明文落库）。

# 图片处理外置扩展（智能去水印 / 超分辨率 / 智能打标）
# 不设置则相关接口 /api/image/ai/* 返回 501；对接说明见 docs/ai-extension.md
# SLINK_AI_ENDPOINT=http://127.0.0.1:9000
# SLINK_AI_TOKEN=
# SLINK_AI_TIMEOUT=120

# LLM 平台（OpenAI 兼容，用于配置与连通性测试，能力预留）
# SLINK_AI_LLM_BASE_URL=https://api.openai.com/v1
# SLINK_AI_LLM_API_KEY=
# SLINK_AI_LLM_MODEL=gpt-4o-mini

# 向量 Embedding 平台（OpenAI 兼容，用于配置与连通性测试，能力预留）
# SLINK_AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# SLINK_AI_EMBEDDING_API_KEY=
# SLINK_AI_EMBEDDING_MODEL=text-embedding-3-small
# SLINK_AI_EMBEDDING_DIMENSIONS=1536
